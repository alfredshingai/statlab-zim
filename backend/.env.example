# StatLab Zim Backend — Environment Variables (Milestone 1)
# Copy to .env and adjust for local development

PROJECT_NAME=StatLab Zim API
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma-separated list, parsed by config.py
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

# Database (Milestone 3)
DATABASE_URL=sqlite:///./statlab.db
# Postgres for production:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/statlab
SECRET_KEY=dev-secret-change-in-production

# Reserved for later milestones
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

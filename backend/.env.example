# StatLab Zim Backend — Environment Variables
# Copy to .env and adjust

PROJECT_NAME=StatLab Zim API
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

# Database
DATABASE_URL=sqlite:///./statlab.db
# Postgres: postgresql+psycopg2://user:password@db:5432/statlab

# Auth
SECRET_KEY=dev-secret-change-in-production

# AI — Version 3
AI_PROVIDER=mock
# mock | openai | ollama — mock is free & deterministic for tests
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# File upload
MAX_UPLOAD_SIZE_MB=50
